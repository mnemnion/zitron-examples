//! Parser for EDN notation

%include {
const tokenize = @import("tokenize.zig");
const Token = tokenize.Token;
const Tokenizer = tokenize.Tokenizer;
const types = @import("types.zig");
const Atom = types.Atom;
const Map = types.Map;
const List = types.List;
const Vector = types.Vector;
const Set = types.Set;
const Form = types.Form;
const FormCons = types.FormCons;

const ParseContext = struct {
    lists: std.mem.MemoryPool(FormCons),

};

%ifdef TRACE
threadlocal var trace_me: *std.Io.Writer = undefined;

const zitron_trace_prompt = "-> ";
%endif

}

%ifdef TRACE
%trace_writer "trace_me"
%endif

%token_type Token

%type form {Form}
%destructor form { $$.deinit(allocator); }
%type atom {Form}
%destructor atom { $$.deinit(allocator); }
%type list {Form}
%destructor list { $$.deinit(allocator); }
%type l_form {Form}
%destructor list { $$.deinit(allocator); }
%type l_forms {*FormCons}
%destructor list { $$.deinit(allocator); }

%ifdef TYPES
%type edn {Form}
%destructor edn { $$.deinit(allocator); }
%type vector {Vector}
%destructor vector { $$.deinit(allocator); }
%type map {Map}
%destructor map { $$.deinit(allocator); }
%endif

edn ::= forms.

forms ::= form forms.
forms ::= form.

form ::= list.
  ``     map.
  ``     vector.
  ``     set.
  ``     tagged.
  ``     discard.
  ``     atom.

list(F) ::= PAL l_forms(L) PAR.  @list_build(F; L)
list(L) ::= PAL PAR.           //    @empty_list(L)

l_forms(L) ::= l_form(F) l_forms(Cdr).    @list_cons(L; F, Cdr)
l_forms(L) ::= l_form(F).                 @lforms_lform(L;F)
l_form ::= form.
map ::= CRL pairs CRR.
map ::= CRL CRR.
vector ::= SQL forms SQR.
vector ::= SQL SQR.
set ::= LSET forms CRR.
set ::= LSET CRR.
tagged ::= TAGGED form.
discard ::= DISCARD form.

pairs ::= pair pairs.

pair ::= form form.

atom(A) ::= SYMBOL(S).   @atom_symbol(A;S)
 ``      NUMBER(N).   //   @atom_number(A;N)
 ``      STRING(S).   //   @atom_string(A;S)
 ``      KEYWORD(K).  //   @atom_keyword(A;K)
 ``      CHARACTER(C).//   @atom_character(A;C)
 ``      NIL(N).      //   @atom_nil(A;N)
 ``      boolean(B).  //   @atom_boolean(A;B)

boolean(B) ::= TRUE|FALSE(T). // {B = Atom.new(T);}

%impl @list_build(F; L) {
    std.debug.print("\nList build: L {s}, F {s}\n", .{@typeName(@TypeOf(L)), @typeName(@TypeOf(F)),});
    F = Form.new(L);
}

%impl @list_cons(L; F, Cdr) {
    std.debug.print("List_const:  {s} cons {s} & {s}\n", .{@typeName(@TypeOf(L)), @typeName(@TypeOf(F)), @typeName(@TypeOf(Cdr))});
    L = try FormCons.create(allocator, F);
    L.cons(Cdr);
}

%impl @atom_symbol(A; S) {
    std.debug.print("Sym: {s}\n", .{S.span});
    const atom = try Atom.new(S, allocator);
    A = Form.new(atom);
    std.debug.print("onstack: {}\n", .{A});
}

%impl @lforms_lform(L;F) {
    std.debug.print("lforms ::= lform\n", .{});
    std.debug.print("type L: {s} type F {s}\n", .{@typeName(@TypeOf(L)), @typeName(@TypeOf(F))});
    L = try FormCons.create(allocator, F);
}

