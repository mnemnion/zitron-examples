//! Parser for EDN notation

%include {
const tokenize = @import("tokenize.zig");
const Token = tokenize.Token;
const Tokenizer = tokenize.Tokenizer;

const types = @import("types.zig");
const Atom = types.Atom;
const Map = types.Map;
const List = types.List;
const Vector = types.Vector;
const Set = types.Set;
const Form = types.Form;
const FormCons = types.FormCons;
const Pair = types.Pair;

const ParseContext = struct {
    lists: std.mem.MemoryPool(FormCons),

};

%ifdef TRACE
threadlocal var trace_me: *std.Io.Writer = undefined;

const zitron_trace_prompt = "-> ";
%endif

} /* end include */

%ifdef TRACE
trace_writer "trace_me"
%endif

/* Types */

%token_type Token

%token CHARACTER. // TODO: shim, remove

%type form {?Form}
%destructor form { if ($$) |form| form.deinit(allocator); }

%type atom {Form}
%destructor atom { $$.deinit(allocator); }

%type list {Form}
%destructor list { $$.deinit(allocator); }

%type map {Form}
%destructor map { $$.deinit(allocator); }

%type set {Form}
%destructor set { $$.deinit(allocator); }

%type s_forms {*Set}
%destructor s_forms { $$.deinit(allocator); } // TODO: Free elements

%type l_forms {?*FormCons}
%destructor l_forms { if ($$) |f_cons| f_cons.deinit(allocator); }

%type discard { ?Form }
%destructor discard { if ($$) |form| form.deinit(allocator); }

%type boolean {*Atom}
%destructor boolean { $$.destroy(allocator); }

%type pair {?*Pair}
%destructor pair { if ($$) |pair| pair.destroy(allocator); }

%type pairs {*Map}
%destructor pairs { $$.deinit(allocator); } // TODO: Free elements

%type m_form { Form }
%destructor m_form { $$.deinit(allocator); }

/* Grammar */

edn ::= forms.

forms ::= form forms.
forms ::= form.

form  ::= list.
  ``      map.
  ``      vector.
  ``      set.
  ``      tagged.
  ``      atom.

form(F) ::=  discard(D). @discard_form(F;D)

list(F) ::= PAL l_forms(L) PAR.  @list_build(F;L)
list(F) ::= PAL PAR.             @empty_list(F)
map(F) ::= CRL pairs(M) CRR.     @map_form(F;M)
map(F) ::= CRL CRR.              @empty_map(F)
vector ::= SQL forms SQR.
vector ::= SQL SQR.
set(F) ::= LSET s_forms(S) CRR.  @set_form(F;S)
set(S) ::= LSET CRR.             @empty_set(S)
tagged ::= TAGGED form.
discard(D) ::= DISCARD form(F).  @on_discard(D;F)

l_forms(L) ::= form(F) l_forms(Cdr).  @list_cons(L; F, Cdr)
l_forms(L) ::= form(F).               @lforms_form(L;F)

pairs(M) ::= pair(P) pairs(Mcdr).         @map_build(M; P, Mcdr)
pairs(M) ::= pair(P).                     @map_init(M;P)
pair(P)  ::= m_form(K) m_form(V).         @on_pair(P; K, V)
pair(P) ::= m_form(K) discard m_form(V).  @on_pair2(P; K, V)
pair(P) ::= discard.                      @discard_in_map(P)

s_forms(S) ::= form(F) s_forms(Set). @set_build(S; F, Set)
  ``           form(F).              @set_init(S;F)

m_form ::= list.
  ``       map.
  ``       vector.
  ``       set.
  ``       tagged.
  ``       atom.

atom(A) ::= SYMBOL(S).      @atom_symbol(A;S)
 ``         NUMBER(N).      @atom_number(A;N)
 ``         STRING(S).      @atom_string(A;S)
 ``         KEYWORD(K).     @atom_keyword(A;K)
 // ``      CHARACTER(C).   @atom_character(A;C)
 ``         NIL(N).         @atom_nil(A;N)
 ``         TRUE|FALSE(B).  @atom_boolean(A;B)

/* Code Actions */

%impl @discard_form(F;D) {
    std.debug.print("Discard to form\n", .{});
    F = D;
    // F-overwrites-D
}


%impl @list_build(F;L) {
    std.debug.print(
        "\nList build: L {s}, F {s}\n",
        .{@typeName(@TypeOf(L)), @typeName(@TypeOf(F)),
    });
    std.debug.print("{?f}\n", .{L});
    F = Form.new(L);
}

%impl @empty_list(F) {
    std.debug.print("Empty list\n", .{});
    F = Form.new(null);
}

%impl @map_form(F;M) {
    std.debug.print("Map-to-form\n", .{});
    F = Form.new(M);
}

%impl @empty_map(F) {
    const map = try allocator.create(Map);
    map.* = .empty;
    F = Form.new(map);
}

%impl @set_form(F;S) {
    std.debug.print("Set-to-form\n", .{});
    F = Form.new(S);
}

%impl @empty_set(S) {
    const set = try allocator.create(Set);
    set.* = .empty;
    S = Form.new(set);
}

%impl @on_discard(D;F) {
    std.debug.print("discarding: {?f}\n", .{F});
    if (F) |form| form.deinit(allocator);
    D = null;
}

%impl @list_cons(L; F, Cdr) {
    std.debug.print(
        "List_cons:  {s} cons {s} & {s}\n",
        .{@typeName(@TypeOf(L)), @typeName(@TypeOf(F)), @typeName(@TypeOf(Cdr))},
    );
    if (F) |form| {
        std.debug.print("  Consing form {f}\n", .{form});
        L = try FormCons.create(allocator, form);
        L.?.cons(Cdr);
    } else {
        std.debug.print("  No cons\n", .{});
        L = Cdr;
    }
}

%impl @lforms_form(L;F) {
    std.debug.print("type L: {s} type F {s}\n", .{@typeName(@TypeOf(L)), @typeName(@TypeOf(F))});
    if (F) |form| {
        L = try FormCons.create(allocator, form);
    } else {
        L = null;
    }
}

%impl @map_build(M; P, Mcdr) {
    std.debug.print("map build\n", .{});
    if (P) |pair| {
        if (try Mcdr.fetchPut(allocator, pair.key, pair.value)) |kv| {
            kv.key.deinit(allocator);
            kv.value.deinit(allocator);
        }
        allocator.destroy(pair);
    }
    M = Mcdr;
}

%impl @map_init(M;P) {
    std.debug.print("init map\n", .{});
    const map = try allocator.create(Map);
    map.* = .empty;
    if (P) |pair| {
        try map.put(allocator, pair.key, pair.value);
        allocator.destroy(pair);
    }
    M = map;
}

%impl @on_pair(P; K, V) {
    std.debug.print("Making a pair: {f} and {f}, into ", .{K, V});
    P = try Pair.create(allocator, K, V);
    std.debug.print("{f}\n", .{P.?});
}

%impl @on_pair2(P; K, V) {
    std.debug.print("Making a pair (after a middle discard): {f} and {f}, into ", .{K, V});
    P = try Pair.create(allocator, K, V);
    std.debug.print("{f}\n", .{P.?});
}

%impl @discard_in_map(P) {
    std.debug.print("Discard in map\n", .{});
    P = null;
}

%impl @set_build(S; F, Set) {
    if (F) |form| {
        if (try Set.fetchPut(allocator, form, {})) |entry| {
            entry.key.deinit(allocator);
        }
    }
    S = Set;
}

%impl @set_init(S; F) {
    const set = try allocator.create(Set);
    set.* = .empty;
    if (F) |form| {
        try set.put(allocator, form, {});
    }
    S = set;
}

%impl @atom_symbol(A; S) {
    const atom = try Atom.new(S, allocator);
    A = Form.new(atom);
    std.debug.print("Symbol: {f}\n", .{A});
}

%impl @atom_number(A; N) {
    const atom = try Atom.new(N, allocator);
    A = Form.new(atom);
    std.debug.print("Number: {f}\n", .{A});
}

%impl @atom_string(A; S) {
    const atom = try Atom.new(S, allocator);
    A = Form.new(atom);
    std.debug.print("String: {f}\n", .{A});
}

%impl @atom_keyword(A; K) {
    const atom = try Atom.new(K, allocator);
    A = Form.new(atom);
    std.debug.print("Keyword: {f}\n", .{A});
}

%impl @atom_nil(A; N) {
    const atom = try Atom.new(N, allocator);
    A = Form.new(atom);
    std.debug.print("nil: {f}\n", .{A});
}

%impl @atom_boolean(A; B) {
    const atom = try Atom.new(B, allocator);
    A = Form.new(atom);
    std.debug.print("boolean: {f}\n", .{A});
}

%code {

const zitron_no_error_recovery = true;

test "parse list" {

%ifdef TRACE
    var stderr_buffer: [1024]u8 = undefined;
    var stderr_writer = std.fs.File.stderr().writer(&stderr_buffer);
    trace_me = &stderr_writer.interface;
%endif
    // Hmm
    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
    defer arena.deinit();
    const allocator = arena.allocator();
    var parser = try Parser.create(allocator);
    defer parser.destroy();
    var tok = Tokenizer.init(
    \\(foo bar baz () #_12 true
    \\   (quux #_:crux :quuux "quuuux")
    \\   {k1 #_toss :v1, #_toss k2 "v2" #_toss} {}
    \\   #{ :moe, "curly" larry #_shemp }
    \\   nil)
    );
    while (try tok.next()) |t| {
        try parser.parse(t.kind, t);
    } else {
        std.debug.print("finalizing\n", .{});
        try parser.finalize();
        std.debug.print("final\n",.{});
    }
}

}
